Screen {
    layout: vertical;
    background: $background;
    color: $text;
}

/* ── Progress Bar ── */

#progress-bar {
    height: 1;
    color: #92a6bc;
    background: #0b1016;
    padding: 0 1;
    border-bottom: tall #21456d;
}

/* ── Status Panel ── */

#status-panel {
    height: 1;
    background: #0e1319;
    color: #8fa2b6;
    padding: 0 1;
    border-bottom: tall #182d44;
}

SystemBubble {
    background: #d7dbe1;
    color: #18212b;
    border-left: wide #24527f;
}

StreamingBubble {
    background: #dde1e6;
    color: #18212b;
    border-left: wide #3c82c9;
}

SystemBubble.tool-bubble {
    background: #d4d8dd;
    color: #1c252e;
    border-left: wide #5f6f84;
}

ActivityBubble {
    background: #d4d8dd;
    border-left: wide #5f6f84;
    color: #1c252e;
}

ThinkingBubble {
    background: #d9dde2;
    color: #364250;
    border-left: wide #8d9aae;
}

UserBubble {
    background: #dfe2e6;
    color: #16202a;
    border-right: wide #5d90c6;
}

ProgressBubble {
    background: #d7dbe0;
    color: #1b2430;
}

StepDivider {
    color: #8fc7ff;
    background: transparent;
}

/* ── Utility classes ── */

.title {
    text-style: bold;
    color: $primary-lighten-2;
    margin: 1 0;
}

.info-text {
    color: $text-muted;
}

.panel-title {
    text-style: bold;
    color: #8fc7ff;
}

.panel-help {
    color: $text-muted;
}

.error-text {
    color: #d78c98;
}

.success-text {
    color: #73b889;
}

.warning-text {
    color: #dfbb69;
}
