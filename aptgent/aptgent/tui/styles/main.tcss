Screen {
    layout: vertical;
    background: $background;
    color: $text;
}

/* ── Progress Bar ── */

#progress-bar {
    height: 1;
    color: $chat-progress-foreground;
    background: $chat-progress-background;
    padding: 0 1;
    border-bottom: tall $chat-progress-border;
}

/* ── Status Panel ── */

#status-panel {
    height: 1;
    background: $chat-status-background;
    color: $chat-status-foreground;
    padding: 0 1;
    border-bottom: tall $chat-status-border;
}

SystemBubble {
    background: $chat-system-background;
    color: $chat-system-foreground;
    border-left: wide $chat-system-accent;
}

StreamingBubble {
    background: $chat-stream-background;
    color: $chat-stream-foreground;
    border-left: wide $chat-stream-accent;
}

SystemBubble.tool-bubble {
    background: $chat-tool-background;
    color: $chat-tool-foreground;
    border-left: wide $chat-tool-accent;
}

ActivityBubble {
    background: $chat-activity-background;
    color: $chat-activity-foreground;
    border-left: wide $chat-activity-accent;
}

ThinkingBubble {
    background: $chat-thinking-background;
    color: $chat-thinking-foreground;
    border-left: wide $chat-thinking-accent;
}

UserBubble {
    background: $chat-user-background;
    color: $chat-user-foreground;
    border-right: wide $chat-user-accent;
}

ProgressBubble {
    background: $chat-stream-background;
    color: $chat-stream-foreground;
}

StepDivider {
    color: $chat-divider-color;
    background: transparent;
}

/* ── Utility classes ── */

.title {
    text-style: bold;
    color: $primary-lighten-2;
    margin: 1 0;
}

.info-text {
    color: $text-muted;
}

.panel-title {
    text-style: bold;
    color: $chat-divider-color;
}

.panel-help {
    color: $text-muted;
}

.error-text {
    color: $error;
}

.success-text {
    color: $success;
}

.warning-text {
    color: $warning;
}
