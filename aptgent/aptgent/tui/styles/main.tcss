Screen {
    layout: vertical;
    background: $surface;
}

/* ── Progress Bar ── */

#progress-bar {
    height: 1;
    color: $text-muted;
    background: $surface-darken-2;
    padding: 0 1;
    border-bottom: tall $surface-lighten-1;
}

/* ── Status Panel ── */

#status-panel {
    height: 1;
    background: $surface-darken-1;
    color: $text-muted;
    padding: 0 1;
    border-bottom: tall $surface-lighten-1;
}

/* ── Utility classes ── */

.title {
    text-style: bold;
    color: $primary-lighten-2;
    margin: 1 0;
}

.info-text {
    color: $text-muted;
}

.panel-title {
    text-style: bold;
}

.panel-help {
    color: $text-muted;
}

.error-text {
    color: $error;
}

.success-text {
    color: $success;
}

.warning-text {
    color: $warning;
}
