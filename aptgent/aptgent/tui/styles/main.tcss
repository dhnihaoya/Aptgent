Screen {
    layout: vertical;
    background: $background;
    color: $text;
}

/* ── Progress Bar ── */

#progress-bar {
    height: 1;
    color: #92a6bc;
    background: #0b1016;
    padding: 0 1;
    border-bottom: tall #21456d;
}

/* ── Status Panel ── */

#status-panel {
    height: 1;
    background: #0e1319;
    color: #8fa2b6;
    padding: 0 1;
    border-bottom: tall #182d44;
}

SystemBubble {
    background: #10151c;
    color: #d7e1ec;
    border-left: wide #24527f;
}

StreamingBubble {
    background: #121821;
    color: #d7e1ec;
    border-left: wide #3c82c9;
}

SystemBubble.tool-bubble {
    background: #141922;
    color: #c6d0db;
    border-left: wide #5f6f84;
}

ActivityBubble {
    background: #141922;
    border-left: wide #5f6f84;
    color: #c6d0db;
}

StepDivider {
    color: #8fc7ff;
    background: transparent;
}

/* ── Utility classes ── */

.title {
    text-style: bold;
    color: $primary-lighten-2;
    margin: 1 0;
}

.info-text {
    color: $text-muted;
}

.panel-title {
    text-style: bold;
}

.panel-help {
    color: $text-muted;
}

.error-text {
    color: $error;
}

.success-text {
    color: $success;
}

.warning-text {
    color: $warning;
}
