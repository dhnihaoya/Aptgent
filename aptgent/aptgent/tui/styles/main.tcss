Screen {
    layout: vertical;
    background: #090b0f;
}

/* ── Progress Bar ── */

#progress-bar {
    height: 1;
    color: #8f9aa3;
    background: #0d1117;
    padding: 0 1;
    border-bottom: tall #556a63;
}

/* ── Status Panel ── */

#status-panel {
    height: 1;
    background: #10151c;
    color: #8f9aa3;
    padding: 0 1;
    border-bottom: tall #222a35;
}

/* ── Utility classes ── */

.title {
    text-style: bold;
    color: $primary-lighten-2;
    margin: 1 0;
}

.info-text {
    color: $text-muted;
}

.panel-title {
    text-style: bold;
}

.panel-help {
    color: $text-muted;
}

.error-text {
    color: $error;
}

.success-text {
    color: $success;
}

.warning-text {
    color: $warning;
}
